{
  "version": 2,
  "builds": [
    { "src": "**/*.php", "use": "@vercel/php" }
  ],
  "routes": [
    {
      "src": "^/(.*\\.php)$",
      "dest": "/$1"
    },
    {
      "src": "^/(.*\\.(css|js|map|svg|png|jpg|jpeg|gif|ico|webp|ttf|woff|woff2|eot|otf|json|txt|html))$",
      "dest": "/$1"
    },
    {
      "src": "^/(.*)$",
      "dest": "/index.php"
    }
  ]
}
